# Copy to .env and fill in. Never commit the real .env.
TOKEN_FACTORY_API_KEY=your_nebius_token_factory_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Models served on Nebius Token Factory:
# - Planner / Drafter / Synthesizer: NVIDIA Nemotron
# - Independent Verifier Jury: DeepSeek-V4-Pro + Qwen3-235B
PLANNER_MODEL=nvidia/nemotron-3-super-120b-a12b
VERIFIER_MODELS=deepseek-ai/DeepSeek-V4-Pro,Qwen/Qwen3-235B-A22B-Instruct-2507

# Optional budget & security limits (0 = unlimited)
DAILY_TOKEN_BUDGET=0
DIGEST_WEBHOOK_URL=

# --- hosting posture (see README "Deployment & ops") ---
DB_PATH=vera.db
WATCH_INTERVAL_MINUTES=0
MAX_WATCHES=0
